# ai-lead-radar — образец окружения. Скопируй в app/.env и подставь свои значения.
# Сам .env в репозиторий не попадает никогда (.gitignore). Здесь только плейсхолдеры.

# --- Telegram: карточки и кнопочная админка ---
BOT_TOKEN=ВСТАВЬ_ТОКЕН_ОТ_BOTFATHER
CHAT_ID=ВСТАВЬ_СВОЙ_CHAT_ID

# --- ИИ: какой режим работает ---
# opencode_cli — локальный CLI, бесплатная модель, 0 ₽ (так крутится демо)
# openai_http  — любой OpenAI-совместимый шлюз под ключ компании
LLM_PROVIDER=opencode_cli

# режим opencode_cli
LLM_CLI=/путь/к/opencode
LLM_MODEL=ВСТАВЬ_ID_МОДЕЛИ_ИЗ_КАТАЛОГА
# HTTP-прокси для CLI. Только http://, не socks5:// — клиент socks5 не умеет.
LLM_PROXY_URL=

# режим openai_http
LLM_BASE_URL=
LLM_API_KEY=

# --- общее для обоих режимов ---
LLM_TIMEOUT=120
LLM_PAUSE=1.0

# --- Telegram: если прямой запрос не проходит — укажи HTTP-прокси ---
# Обычно тот же HTTP-прокси, что у модели. Пусто — ходим напрямую.
TG_PROXY_URL=

# --- Google Таблица (необязательно; пусто = работает только CSV) ---
GOOGLE_SHEET_WEBHOOK_URL=
SHEET_TOKEN=
